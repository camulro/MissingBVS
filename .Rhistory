H <- function(l,n) {
suma <- 0
for (i in 1:l) {
suma <- suma + (1+n)^((1-i)/2)*1/l
}
}
H(5,30)
suma
H <- function(l,n) {
suma <- 0
for (i in 1:l) {
suma <- suma + (1+n)^((1-i)/2)*1/l
}
suma
}
H(5,30)
H(5,50)
H(5,100)
H(5,1000)
H(10,30)
H(10,50)
H(10,1000)
H(30,30)
H(30,50)
H(30,1000)
